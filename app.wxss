/**app.wxss**/
@import '@vant/weapp/common/index.wxss';

/* 全局样式 */
page {
  background-color: #f8f9fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

/* 主题色定义 */
:root {
  --primary-color: #36D399;
  --secondary-color: #3B82F6;
  --success-color: #10B981;
  --warning-color: #F59E0B;
  --error-color: #EF4444;
  --text-primary: #1F2937;
  --text-secondary: #6B7280;
  --text-disabled: #9CA3AF;
  --border-color: #E5E7EB;
  --background-light: #F9FAFB;
}

/* 通用容器 */
.container {
  padding: 32rpx;
  min-height: 100vh;
}

.page-container {
  padding: 0 32rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

/* 卡片样式 */
.card {
  background-color: white;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.card-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 按钮样式 */
.btn-primary {
  background-color: var(--primary-color) !important;
  border-color: var(--primary-color) !important;
  color: white !important;
  border-radius: 12rpx !important;
  font-weight: 500 !important;
}

.btn-secondary {
  background-color: var(--secondary-color) !important;
  border-color: var(--secondary-color) !important;
  color: white !important;
  border-radius: 12rpx !important;
  font-weight: 500 !important;
}

.btn-outline {
  background-color: transparent !important;
  border: 2rpx solid var(--primary-color) !important;
  color: var(--primary-color) !important;
  border-radius: 12rpx !important;
}

/* 文本样式 */
.text-primary {
  color: var(--text-primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-success {
  color: var(--success-color);
}

.text-warning {
  color: var(--warning-color);
}

.text-error {
  color: var(--error-color);
}

/* 标签样式 */
.tag-primary {
  background-color: var(--primary-color);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  display: inline-block;
  margin-right: 16rpx;
  margin-bottom: 8rpx;
}

.tag-secondary {
  background-color: var(--background-light);
  color: var(--text-secondary);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  display: inline-block;
  margin-right: 16rpx;
  margin-bottom: 8rpx;
}

/* 头像样式 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
}

.avatar-large {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
}

/* 列表项样式 */
.list-item {
  background-color: white;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border-color);
  display: flex;
  align-items: center;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-content {
  flex: 1;
  margin-left: 24rpx;
}

.list-item-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.list-item-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 状态样式 */
.status-pending {
  color: var(--warning-color);
}

.status-confirmed {
  color: var(--primary-color);
}

.status-completed {
  color: var(--success-color);
}

.status-cancelled {
  color: var(--error-color);
}

/* 工具类 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.mt-16 {
  margin-top: 16rpx;
}

.mt-24 {
  margin-top: 24rpx;
}

.mt-32 {
  margin-top: 32rpx;
}

.mb-16 {
  margin-bottom: 16rpx;
}

.mb-24 {
  margin-bottom: 24rpx;
}

.mb-32 {
  margin-bottom: 32rpx;
}

.p-16 {
  padding: 16rpx;
}

.p-24 {
  padding: 24rpx;
}

.p-32 {
  padding: 32rpx;
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
