<!--pages/chat/chat.wxml-->
<view class="chat-container">
  <!-- 聊天消息列表 -->
  <scroll-view 
    class="message-list" 
    scroll-y="true" 
    scroll-top="{{scrollTop}}"
    scroll-into-view="{{scrollIntoView}}"
    bindscrolltoupper="loadMoreMessages"
  >
    <!-- 加载更多提示 -->
    <view wx:if="{{loadingMore}}" class="loading-more">
      <van-loading type="spinner" size="32rpx" />
      <text>加载更多...</text>
    </view>
    
    <!-- 消息列表 -->
    <view class="message-item {{message.fromId === currentUserId ? 'self' : 'other'}}" 
          wx:for="{{messageList}}" 
          wx:key="_id"
          id="message-{{index}}">
      
      <!-- 时间分割线 -->
      <view wx:if="{{message.showTime}}" class="time-divider">
        <text>{{message.timeText}}</text>
      </view>
      
      <view class="message-content">
        <!-- 对方头像 -->
        <image wx:if="{{message.fromId !== currentUserId}}" 
               class="avatar" 
               src="{{targetAvatar || '/images/default-avatar.png'}}" 
               mode="aspectFill" />
        
        <!-- 消息气泡 -->
        <view class="message-bubble {{message.fromId === currentUserId ? 'self-bubble' : 'other-bubble'}}">
          <!-- 文本消息 -->
          <text wx:if="{{message.type === 'text'}}" class="message-text">{{message.content}}</text>
          
          <!-- 图片消息 -->
          <image wx:elif="{{message.type === 'image'}}" 
                 class="message-image" 
                 src="{{message.content}}" 
                 mode="aspectFill"
                 bindtap="previewImage"
                 data-url="{{message.content}}" />
          
          <!-- 系统消息 -->
          <text wx:elif="{{message.type === 'system'}}" class="system-message">{{message.content}}</text>
        </view>
        
        <!-- 自己头像 -->
        <image wx:if="{{message.fromId === currentUserId}}" 
               class="avatar" 
               src="{{userAvatar || '/images/default-avatar.png'}}" 
               mode="aspectFill" />
      </view>
      
      <!-- 消息状态 -->
      <view wx:if="{{message.fromId === currentUserId}}" class="message-status">
        <van-icon wx:if="{{message.status === 'sending'}}" name="clock-o" size="24rpx" color="#9CA3AF" />
        <van-icon wx:elif="{{message.status === 'failed'}}" name="warning-o" size="24rpx" color="#EF4444" />
      </view>
    </view>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="input-section">
    <!-- 功能按钮 -->
    <view class="input-actions">
      <van-icon name="photo-o" size="48rpx" color="#6B7280" bindtap="chooseImage" />
      <van-icon name="gold-coin-o" size="48rpx" color="#F59E0B" bindtap="showPriceConfirm" />
    </view>
    
    <!-- 输入框 -->
    <view class="input-wrapper">
      <van-field
        value="{{inputText}}"
        type="textarea"
        placeholder="输入消息..."
        bind:input="onInputChange"
        bind:confirm="sendMessage"
        autosize
        maxlength="500"
        border="{{false}}"
        custom-style="background-color: #F3F4F6; border-radius: 24rpx; padding: 16rpx 24rpx;"
      />
    </view>
    
    <!-- 发送按钮 -->
    <van-button 
      type="primary" 
      size="small" 
      class="send-btn"
      bindtap="sendMessage"
      disabled="{{!inputText.trim() || sending}}"
      loading="{{sending}}"
    >
      发送
    </van-button>
  </view>
</view>

<!-- 价格确认弹窗 -->
<van-popup show="{{showPriceModal}}" position="center" round bind:close="closePriceModal">
  <view class="price-modal">
    <view class="modal-title">确认价格</view>
    <view class="modal-desc">与对方确认最终价格，双方同意后将生成订单</view>
    
    <van-field
      label="价格"
      value="{{confirmPrice}}"
      type="number"
      placeholder="请输入价格"
      bind:input="onPriceInput"
      right-icon="question-o"
      bind:click-right-icon="showPriceTips"
    >
      <text slot="button">元</text>
    </van-field>
    
    <view class="modal-actions">
      <van-button type="default" bindtap="closePriceModal">取消</van-button>
      <van-button 
        type="primary" 
        bindtap="sendPriceConfirm"
        disabled="{{!confirmPrice || confirmPrice <= 0}}"
        loading="{{priceLoading}}"
      >
        发送
      </van-button>
    </view>
  </view>
</van-popup>

<!-- Toast组件 -->
<van-toast id="van-toast" />
