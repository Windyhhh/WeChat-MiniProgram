/* pages/role-select/role-select.wxss */

.role-select-container {
  min-height: 100vh;
  background-color: #f8f9fa;
  padding: 60rpx 40rpx 40rpx;
}

/* 顶部说明 */
.header-section {
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  padding: 0 20rpx;
}

/* 身份选择区域 */
.roles-section {
  margin-bottom: 60rpx;
}

.role-card {
  background-color: white;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 3rpx solid transparent;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.role-card.selected {
  border-color: var(--primary-color);
  box-shadow: 0 8rpx 24rpx rgba(54, 211, 153, 0.2);
  transform: translateY(-4rpx);
}

.role-card:active {
  transform: scale(0.98);
}

.role-icon {
  text-align: center;
  margin-bottom: 32rpx;
}

.role-info {
  text-align: center;
}

.role-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.role-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.role-features {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.feature-item text {
  margin-left: 12rpx;
}

.role-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 温馨提示 */
.tips-section {
  background-color: rgba(245, 158, 11, 0.1);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 60rpx;
  border-left: 6rpx solid #F59E0B;
}

.tips-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #F59E0B;
  margin-bottom: 20rpx;
}

.tips-title text {
  margin-left: 12rpx;
}

.tips-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tips-content text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 确认按钮区域 */
.confirm-section {
  text-align: center;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  margin-bottom: 32rpx;
}

.skip-btn {
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  text-decoration: underline;
}

/* 动画效果 */
@keyframes cardSelect {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.02);
  }
  100% {
    transform: scale(1);
  }
}

.role-card.selected {
  animation: cardSelect 0.3s ease;
}

/* 响应式适配 */
@media (max-width: 750rpx) {
  .role-select-container {
    padding: 40rpx 32rpx;
  }
  
  .title {
    font-size: 40rpx;
  }
  
  .role-card {
    padding: 32rpx;
  }
  
  .role-title {
    font-size: 32rpx;
  }
}
