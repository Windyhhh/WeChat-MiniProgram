/* pages/task-publish/task-publish.wxss */

.publish-container {
  min-height: 100vh;
  background-color: #f8f9fa;
  padding-bottom: 120rpx;
}

/* 步骤指示器 */
.steps-section {
  background-color: white;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}

/* 步骤内容 */
.step-content {
  padding: 0 32rpx;
}

.step-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 32rpx;
  text-align: center;
}

/* 表单样式 */
.van-cell-group {
  border-radius: 16rpx !important;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.van-cell {
  background-color: white !important;
}

.van-field__label {
  color: var(--text-primary) !important;
  font-weight: 500 !important;
}

.van-field__input {
  color: var(--text-primary) !important;
}

.van-field__placeholder {
  color: var(--text-disabled) !important;
}

/* 历史课程 */
.history-courses {
  background-color: white;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.course-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 图片上传 */
.upload-section {
  background-color: white;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.upload-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

/* 预算建议 */
.budget-tips {
  background-color: rgba(59, 130, 246, 0.1);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-top: 32rpx;
  border-left: 6rpx solid #3B82F6;
}

.tips-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #3B82F6;
  margin-bottom: 20rpx;
}

.tips-title text {
  margin-left: 12rpx;
}

.tips-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tips-content text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 操作按钮 */
.actions-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: white;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border-color);
  display: flex;
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx !important;
  border-radius: 44rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
}

/* 自定义上传器样式 */
.van-uploader__upload {
  border: 2rpx dashed var(--border-color) !important;
  border-radius: 12rpx !important;
  background-color: #f8f9fa !important;
}

.van-uploader__upload:active {
  border-color: var(--primary-color) !important;
  background-color: rgba(54, 211, 153, 0.05) !important;
}

.van-uploader__upload-text {
  color: var(--text-secondary) !important;
  font-size: 28rpx !important;
}

.van-uploader__preview-image {
  border-radius: 12rpx !important;
}

/* 步骤样式覆盖 */
.van-step__title {
  font-size: 28rpx !important;
  color: var(--text-primary) !important;
}

.van-step__title--active {
  color: var(--primary-color) !important;
  font-weight: 600 !important;
}

.van-step__title--finish {
  color: var(--primary-color) !important;
}

.van-step__circle {
  background-color: var(--primary-color) !important;
}

.van-step__line {
  background-color: var(--primary-color) !important;
}

/* 选择器样式 */
.van-picker__toolbar {
  background-color: white !important;
}

.van-picker__title {
  color: var(--text-primary) !important;
  font-weight: 600 !important;
}

.van-picker__confirm {
  color: var(--primary-color) !important;
}

.van-picker__cancel {
  color: var(--text-secondary) !important;
}

/* 标签样式 */
.van-tag {
  border-radius: 8rpx !important;
  margin-right: 16rpx !important;
  margin-bottom: 12rpx !important;
}

.van-tag--plain {
  background-color: rgba(54, 211, 153, 0.1) !important;
  color: var(--primary-color) !important;
  border-color: var(--primary-color) !important;
}

/* 响应式适配 */
@media (max-width: 750rpx) {
  .publish-container {
    padding-bottom: 100rpx;
  }
  
  .step-content {
    padding: 0 24rpx;
  }
  
  .steps-section {
    padding: 32rpx 24rpx;
  }
  
  .actions-section {
    padding: 20rpx 24rpx;
    padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  }
  
  .action-btn {
    height: 80rpx !important;
    font-size: 30rpx !important;
  }
}
