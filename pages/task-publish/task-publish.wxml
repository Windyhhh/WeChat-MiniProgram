<!--pages/task-publish/task-publish.wxml-->
<view class="publish-container">
  <!-- 步骤指示器 -->
  <view class="steps-section">
    <van-steps steps="{{steps}}" active="{{currentStep}}" />
  </view>

  <!-- 步骤1：基础信息 -->
  <view class="step-content" wx:if="{{currentStep === 0}}">
    <view class="step-title">基础信息</view>
    
    <van-cell-group>
      <van-field
        label="课程名称"
        value="{{formData.course}}"
        placeholder="请输入课程名称"
        bind:input="onCourseInput"
        required
      />
      
      <van-cell 
        title="任务类型" 
        value="{{taskTypeText}}" 
        is-link 
        bind:click="showTaskTypePicker"
        required
      />
      
      <van-cell 
        title="辅导方式" 
        value="{{tutorModeText}}" 
        is-link 
        bind:click="showTutorModePicker"
        required
      />
    </van-cell-group>

    <!-- 历史课程快选 -->
    <view class="history-courses" wx:if="{{historyCourses.length > 0}}">
      <view class="section-title">最近课程</view>
      <view class="course-tags">
        <van-tag 
          wx:for="{{historyCourses}}" 
          wx:key="index"
          size="small" 
          type="primary" 
          plain
          bindtap="selectHistoryCourse"
          data-course="{{item}}"
        >
          {{item}}
        </van-tag>
      </view>
    </view>
  </view>

  <!-- 步骤2：需求详情 -->
  <view class="step-content" wx:if="{{currentStep === 1}}">
    <view class="step-title">需求详情</view>
    
    <van-cell-group>
      <van-field
        label="任务标题"
        value="{{formData.title}}"
        placeholder="请输入任务标题"
        bind:input="onTitleInput"
        maxlength="50"
        required
      />
      
      <van-field
        label="详细描述"
        value="{{formData.description}}"
        type="textarea"
        placeholder="请详细描述您的辅导需求..."
        bind:input="onDescriptionInput"
        autosize
        maxlength="500"
        show-word-limit
        required
      />
    </van-cell-group>

    <!-- 图片上传 -->
    <view class="upload-section">
      <view class="upload-title">相关图片（选填）</view>
      <van-uploader
        file-list="{{formData.images}}"
        bind:after-read="afterRead"
        bind:delete="deleteImage"
        max-count="3"
        accept="image"
        upload-text="上传图片"
      />
    </view>

    <!-- 地点选择（线下辅导） -->
    <van-cell-group wx:if="{{formData.tutorMode === 'offline' || formData.tutorMode === 'both'}}">
      <van-field
        label="辅导地点"
        value="{{formData.location}}"
        placeholder="请输入具体地点"
        bind:input="onLocationInput"
        required="{{formData.tutorMode === 'offline'}}"
      />
    </van-cell-group>
  </view>

  <!-- 步骤3：时间预算 -->
  <view class="step-content" wx:if="{{currentStep === 2}}">
    <view class="step-title">时间预算</view>
    
    <van-cell-group>
      <van-cell 
        title="期望完成时间" 
        value="{{expectedTimeText}}" 
        is-link 
        bind:click="showDatePicker"
        required
      />
      
      <van-field
        label="预算金额"
        value="{{formData.budget}}"
        type="number"
        placeholder="请输入预算金额"
        bind:input="onBudgetInput"
        right-icon="question-o"
        bind:click-right-icon="showBudgetTips"
        required
      >
        <text slot="button">元</text>
      </van-field>
    </van-cell-group>

    <!-- 预算建议 -->
    <view class="budget-tips">
      <view class="tips-title">
        <van-icon name="info-o" size="28rpx" color="#3B82F6" />
        <text>预算建议</text>
      </view>
      <view class="tips-content">
        <text>• 作业辅导：20-50元/小时</text>
        <text>• 论文指导：50-100元/小时</text>
        <text>• 复习备考：30-80元/小时</text>
        <text>• 合理的预算能吸引更多优质辅导者</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions-section">
    <van-button 
      wx:if="{{currentStep > 0}}"
      type="default" 
      class="action-btn" 
      bindtap="prevStep"
    >
      上一步
    </van-button>
    
    <van-button 
      wx:if="{{currentStep < 2}}"
      type="primary" 
      class="action-btn" 
      bindtap="nextStep"
      disabled="{{!canNext}}"
    >
      下一步
    </van-button>
    
    <van-button 
      wx:if="{{currentStep === 2}}"
      type="primary" 
      class="action-btn" 
      bindtap="publishTask"
      loading="{{publishLoading}}"
      disabled="{{!canPublish || publishLoading}}"
    >
      发布任务
    </van-button>
  </view>
</view>

<!-- 任务类型选择器 -->
<van-popup show="{{showTaskType}}" position="bottom" bind:close="closeTaskTypePicker">
  <van-picker
    columns="{{taskTypeColumns}}"
    bind:confirm="onTaskTypeConfirm"
    bind:cancel="closeTaskTypePicker"
    show-toolbar
    title="选择任务类型"
  />
</van-popup>

<!-- 辅导方式选择器 -->
<van-popup show="{{showTutorMode}}" position="bottom" bind:close="closeTutorModePicker">
  <van-picker
    columns="{{tutorModeColumns}}"
    bind:confirm="onTutorModeConfirm"
    bind:cancel="closeTutorModePicker"
    show-toolbar
    title="选择辅导方式"
  />
</van-popup>

<!-- 日期选择器 -->
<van-popup show="{{showDatePicker}}" position="bottom" bind:close="closeDatePicker">
  <van-datetime-picker
    type="date"
    value="{{expectedTime}}"
    min-date="{{minDate}}"
    bind:confirm="onDateConfirm"
    bind:cancel="closeDatePicker"
    title="选择期望完成时间"
  />
</van-popup>

<!-- Toast组件 -->
<van-toast id="van-toast" />
