/* pages/settings/settings.wxss */
.settings-container {
  background-color: #f7f8fa;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.settings-section {
  margin-bottom: 20rpx;
}

.section-title {
  padding: 30rpx 30rpx 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
}

.logout-section {
  margin: 60rpx 30rpx 30rpx;
}

/* 自定义开关样式 */
.van-switch {
  transform: scale(0.8);
}

/* 单元格自定义样式 */
.van-cell {
  padding: 24rpx 30rpx;
}

.van-cell__title {
  font-size: 30rpx;
  color: #323233;
}

.van-cell__value {
  font-size: 28rpx;
  color: #969799;
}

/* 危险操作按钮 */
.van-button--danger {
  background: linear-gradient(135deg, #ff6b6b, #ee5a52);
  border: none;
  border-radius: 12rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(238, 90, 82, 0.3);
}

/* 响应式适配 */
@media (max-width: 375px) {
  .section-title {
    font-size: 26rpx;
    padding: 25rpx 25rpx 15rpx;
  }
  
  .van-cell {
    padding: 20rpx 25rpx;
  }
  
  .logout-section {
    margin: 50rpx 25rpx 25rpx;
  }
}
