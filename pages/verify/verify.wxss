/* pages/verify/verify.wxss */

.verify-container {
  min-height: 100vh;
  background-color: #f8f9fa;
  padding: 40rpx;
}

/* 顶部说明 */
.header-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.verify-icon {
  margin-bottom: 32rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 表单区域 */
.form-section {
  margin-bottom: 60rpx;
}

/* 上传区域 */
.upload-section {
  background-color: white;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-top: 32rpx;
}

.upload-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.required {
  color: var(--error-color);
  margin-left: 8rpx;
}

.upload-tips {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 32rpx;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  border-left: 4rpx solid var(--primary-color);
}

/* 信息说明 */
.info-section {
  background-color: rgba(59, 130, 246, 0.1);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-top: 32rpx;
  border-left: 6rpx solid #3B82F6;
}

.info-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #3B82F6;
  margin-bottom: 20rpx;
}

.info-title text {
  margin-left: 12rpx;
}

.info-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-content text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 提交按钮区域 */
.submit-section {
  text-align: center;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  margin-bottom: 32rpx;
}

.skip-btn {
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  text-decoration: underline;
}

/* 自定义上传器样式 */
.van-uploader__upload {
  border: 2rpx dashed var(--border-color) !important;
  border-radius: 12rpx !important;
  background-color: #f8f9fa !important;
}

.van-uploader__upload:active {
  border-color: var(--primary-color) !important;
  background-color: rgba(54, 211, 153, 0.05) !important;
}

.van-uploader__upload-text {
  color: var(--text-secondary) !important;
  font-size: 28rpx !important;
}

.van-uploader__preview-image {
  border-radius: 12rpx !important;
}

/* 表单字段样式覆盖 */
.van-cell {
  background-color: white !important;
  border-radius: 16rpx !important;
  margin-bottom: 2rpx !important;
}

.van-cell:first-child {
  border-top-left-radius: 16rpx !important;
  border-top-right-radius: 16rpx !important;
}

.van-cell:last-child {
  border-bottom-left-radius: 16rpx !important;
  border-bottom-right-radius: 16rpx !important;
}

.van-field__label {
  color: var(--text-primary) !important;
  font-weight: 500 !important;
}

.van-field__input {
  color: var(--text-primary) !important;
}

.van-field__placeholder {
  color: var(--text-disabled) !important;
}

/* 选择器样式 */
.van-picker__toolbar {
  background-color: white !important;
}

.van-picker__title {
  color: var(--text-primary) !important;
  font-weight: 600 !important;
}

.van-picker__confirm {
  color: var(--primary-color) !important;
}

.van-picker__cancel {
  color: var(--text-secondary) !important;
}

/* 响应式适配 */
@media (max-width: 750rpx) {
  .verify-container {
    padding: 32rpx 24rpx;
  }
  
  .title {
    font-size: 40rpx;
  }
  
  .upload-section,
  .info-section {
    padding: 24rpx;
  }
}
